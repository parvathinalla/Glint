# Example values only. Put secrets in ignored .env.local or deployment secrets.
PORT=3100
APP_ORIGIN=http://127.0.0.1:3100
# Render supplies PORT and RENDER_EXTERNAL_URL; omit this local APP_ORIGIN there.
# Production binds to 0.0.0.0 by default; HOST can explicitly override it.
# Optional private local SQLite location; defaults to .data/glint.sqlite
# GLINT_DATA_DIR=

# Isolated /livekit voice prototype. Off until explicitly configured.
GLINT_LIVEKIT_ENABLED=0
GLINT_LIVEKIT_AGENT_ENABLED=0
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Use a random code with at least 16 characters, separate from API secrets.
GLINT_LIVEKIT_ACCESS_CODE=
GLINT_LIVEKIT_AGENT_NAME=glint-prototype
# These STT/TTS models use LiveKit Inference billing, NOT BaseTen hackathon credits.
# Choose supported models and a voice in your LiveKit account before enabling.
GLINT_LIVEKIT_STT_MODEL=
GLINT_LIVEKIT_TTS_MODEL=
GLINT_LIVEKIT_TTS_VOICE=
# meta (recommended), baseten or fireworks; keys stay in the agent process.
GLINT_LIVEKIT_LLM_PROVIDER=meta
GLINT_LIVEKIT_LLM_MODEL=muse-spark-1.3
MODEL_API_KEY=
# Use LiveKit Inference for existing Glint replies (keeps current audio transport).
GLINT_TTS_PROVIDER=livekit
BASETEN_API_KEY=
FIREWORKS_API_KEY=
