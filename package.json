{
  "name": "glint-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx backend/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx backend/index.ts --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/prepare-vision.mjs && node scripts/prepare-vad.mjs && node scripts/prepare-tts.mjs",
    "predev": "node scripts/prepare-vision.mjs && node scripts/prepare-vad.mjs && node scripts/prepare-tts.mjs",
    "prebuild": "node scripts/prepare-vision.mjs && node scripts/prepare-vad.mjs && node scripts/prepare-tts.mjs",
    "livekit:agent": "tsx backend/livekit-runner.ts",
    "livekit:download": "tsx backend/livekit-runner.ts download-files",
    "dev:submission": "tsx scripts/submission.ts dev",
    "build:submission": "tsx scripts/submission.ts build",
    "start:submission": "tsx scripts/submission.ts start",
    "test:submission": "playwright test -c playwright.submission.config.ts"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.5",
    "@livekit/agents-plugin-openai": "^1.9.5",
    "@livekit/agents-plugin-silero": "^1.9.5",
    "@mediapipe/tasks-vision": "1.2.0",
    "@meta-sam/parser": "0.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "^1.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sherpa-onnx-node": "^2.0.1",
    "tsx": "^4.23.15",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "description": "A standalone AI companion for hands-on tasks. This first local slice is a **checkpoint prototype**, with a blue star companion, camera controls, hands-free voice conversation, optional link research, and session-only BYOK.",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parvathinalla/Glint.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/parvathinalla/Glint/issues"
  },
  "homepage": "https://github.com/parvathinalla/Glint#readme",
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
